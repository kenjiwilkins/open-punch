# admin のサーバー側環境変数（値はコミットしない）。
# COGNITO_* は SST の Cognito 出力・Hosted UI 設定から、GRAPHQL_URL は GraphQL 関数の URL から。

# GraphQL エンドポイント（末尾に /graphql）
GRAPHQL_URL=https://xxxxx.lambda-url.ap-northeast-1.on.aws/graphql

# admin のベース URL（コールバック/ログアウトの戻り先。Cognito 登録値と一致させる）
ADMIN_URL=http://localhost:3000

# Cognito Hosted UI
COGNITO_DOMAIN=https://open-punch-<stage>.auth.ap-northeast-1.amazoncognito.com
COGNITO_CLIENT_ID=
COGNITO_USER_POOL_ID=
COGNITO_REGION=ap-northeast-1
