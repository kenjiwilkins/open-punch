{
  "name": "open-punch",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy",
    "sst": "sst",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "codegen": "pnpm --filter @open-punch/graphql emit-schema && pnpm --filter kiosk codegen"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "sst": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
